{
  "name": "rainsync",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "test:accounts": "node tests/account-rules.mjs && node tests/registration-invites.mjs && node tests/registration.mjs && node tests/avatar-upload.mjs",
    "test:e2e": "playwright test",
    "test:library-player-real": "node tests/library-player-real.mjs",
    "test:browser-real": "node tests/browser-real.mjs",
    "test:chat": "node tests/chat-idempotency.mjs",
    "test:avatar-container": "node tests/avatar-container.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
