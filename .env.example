# Generate separate random values. Never commit the real .env.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
ADMIN_PASSWORD=replace-with-8-or-more-printable-ASCII-characters
# Base64 encoded 32 random bytes. Preserve this key with database backups.
SOURCE_ENCRYPTION_KEY=
MEDIA_PATH=./media
# Control-plane public origin, without path, credentials, query or fragment.
PUBLIC_ORIGIN=http://localhost:8088
# Optional explicit media origin (must equal PUBLIC_ORIGIN) and Agent data ingress.
# Native Agent data retains independent HTTP(S) origin support.
# MEDIA_ORIGIN=http://localhost:8088
# AGENT_DATA_ORIGIN=https://data.example.invalid
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
# Shared cache quota and reservation for media whose duration is unknown.
CACHE_MAX_BYTES=21474836480
CACHE_UNKNOWN_OUTPUT_BYTES=2147483648
# Active sessions (including pending preparation) per user; queued + running jobs globally.
PLAYBACK_SESSION_LIMIT=2
MEDIA_QUEUE_LIMIT=20
# New anonymous account requests share database-backed windows. Zero disables nothing.
REGISTRATION_VALIDATE_PER_MINUTE=30
REGISTRATION_PER_TEN_MINUTES=10
ACCOUNT_HASH_CONCURRENCY=2
# Explicit proxy IP/CIDR allowlist; empty means only the socket peer is trusted.
# Configure the actual reverse-proxy network, never a broad Internet allowlist.
TRUSTED_PROXY_CIDRS=
# Independent avatar processing, never queued with media transcodes.
AVATAR_PROCESS_CONCURRENCY=2
AVATAR_PROCESS_TIMEOUT_MS=5000
AVATAR_WRITES_PER_MINUTE=10
# Optional local executable override; default is ffmpeg on PATH.
# AVATAR_FFMPEG_BIN=/usr/bin/ffmpeg
# Independent authenticated thumbnail queue and database image budget.
MEDIA_PREVIEW_CONCURRENCY=1
MEDIA_PREVIEW_TIMEOUT_SECONDS=30
MEDIA_PREVIEW_CACHE_BYTES=134217728
MEDIA_PREVIEW_QUEUE_LIMIT=128
MEDIA_PREVIEW_INPUT_BYTES=268435456

# Recovery tooling only: operator-assigned version for the matching source key.
# SOURCE_KEY_VERSION=preview-1
# Separate private 32-byte binary keys; never reuse the database backup key.
# RAINSYNC_BACKUP_KEY_FILE=/private/database-backup-key
# RAINSYNC_MATERIAL_KEY_FILE=/separate-private/application-material-key
