# Optional ordinary-job encoder selection; retain the deployment's required
# database, encryption, origins and account settings described in README.md.
# Values: software (default), prefer_nvenc, prefer_qsv, prefer_vaapi.
# This does not mount GPUs, change permissions or validate driver availability.
RAINSYNC_VIDEO_ENCODER=software

# Static HLS is independently opt-in at both services and in the viewer UI.
# Values 0 (default) or 1. Requires coordinated validated Server/Worker/DB/cache.
# Editing this sample does not enable a running deployment.
STATIC_HLS_PARENT_PREPARE_ENABLED=0
STATIC_HLS_CHILD_EXECUTION_ENABLED=0
