{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackRequest",
  "description": "Missing optional fields preserve the original v1 playback request defaults.",
  "type": "object",
  "properties": {
    "audio_index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "candidate_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackCandidateReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackCapabilities"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "http_file_fallback": {
      "anyOf": [
        {
          "$ref": "#/$defs/HttpFileFallback"
        },
        {
          "type": "null"
        }
      ]
    },
    "http_file_fallback_version": {
      "description": "Negotiate single-hop verified HTTP-file continuation; absence is legacy.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "default": null
    },
    "media_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "observation_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "plan_generation": {
      "description": "Positive monotonic intent generation within user/room/viewer scope.\nMust be supplied together with viewer_id; same-key retries retain it.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1
    },
    "playback_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackMetricsIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "playback_metrics_version": {
      "description": "Optional independent client-reported metrics; observations v1 is unchanged.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "position_ms": {
      "type": "number",
      "format": "double",
      "default": 0.0
    },
    "room_id": {
      "type": "string",
      "format": "uuid"
    },
    "viewer_id": {
      "description": "Opaque per-player identity for ordering only, never authorization.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "room_id",
    "media_generation"
  ],
  "$defs": {
    "AudioCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channels": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "samplerate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "channels",
        "bitrate",
        "samplerate"
      ]
    },
    "CapabilityReport": {
      "description": "A small set of concrete sample hints, not a device-wide codec/size guarantee.",
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaCapabilityCandidate"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "candidates"
      ]
    },
    "HttpFileFallback": {
      "description": "A parent ID is only an authenticated lookup key, never a bearer grant.\nThe final observation is captured once before detaching the parent's media.",
      "type": "object",
      "properties": {
        "final_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "parent_session_id"
      ]
    },
    "MediaCapabilityCandidate": {
      "type": "object",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioCapabilityConfiguration"
        },
        "content_type": {
          "description": "Combined container/codec MIME type tested through canPlayType and MSE.",
          "type": "string"
        },
        "file_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "description": "Omitted means unavailable or failed, not supported.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "progressive": {
          "$ref": "#/$defs/MediaTypeSupport"
        },
        "video": {
          "$ref": "#/$defs/VideoCapabilityConfiguration"
        }
      },
      "required": [
        "content_type",
        "video",
        "audio",
        "progressive"
      ]
    },
    "MediaDecodingSupport": {
      "description": "Estimates apply only to the accompanying configuration and decoding path.",
      "type": "object",
      "properties": {
        "power_efficient": {
          "type": "boolean"
        },
        "smooth": {
          "type": "boolean"
        },
        "supported": {
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "smooth",
        "power_efficient"
      ]
    },
    "MediaTypeSupport": {
      "description": "Browser MIME-type hints are not guarantees for arbitrary media or hardware.",
      "type": "string",
      "enum": [
        "unknown",
        "unsupported",
        "maybe",
        "probably"
      ]
    },
    "PlaybackCandidateReport": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "excluded_candidates": {
          "description": "Bounded client decode-failure history; never changes authorization.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaybackCandidateResult"
          }
        }
      },
      "required": [
        "binding",
        "results"
      ]
    },
    "PlaybackCandidateResult": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "file_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "progressive": {
          "$ref": "#/$defs/MediaTypeSupport"
        }
      },
      "required": [
        "candidate_id",
        "progressive"
      ]
    },
    "PlaybackCapabilities": {
      "description": "Independently detected transports; MSE support does not imply progressive support.",
      "type": "object",
      "properties": {
        "mse_h264_aac": {
          "type": "boolean"
        },
        "native_hls": {
          "type": "boolean"
        },
        "progressive_h264_aac": {
          "type": "boolean"
        },
        "report": {
          "description": "Optional additive hints. Old clients retain the original transport gates.",
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "progressive_h264_aac",
        "native_hls",
        "mse_h264_aac"
      ]
    },
    "PlaybackMetricsIntent": {
      "type": "object",
      "properties": {
        "meter_start_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "startup_origin": {
          "$ref": "#/$defs/PlaybackMetricsOrigin"
        }
      },
      "additionalProperties": false,
      "required": [
        "meter_start_generation",
        "startup_origin"
      ]
    },
    "PlaybackMetricsOrigin": {
      "type": "string",
      "enum": [
        "user_intent",
        "automatic_load"
      ]
    },
    "PlaybackObservation": {
      "description": "An immutable sample of the actual media element, relative to its plan.\n`has_played` is cumulative for that grant, even when the latest sample pauses.",
      "type": "object",
      "properties": {
        "buffering": {
          "type": "boolean"
        },
        "event": {
          "$ref": "#/$defs/PlaybackObservationEvent"
        },
        "has_played": {
          "type": "boolean"
        },
        "media_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "media_time_ms": {
          "type": "number",
          "format": "double"
        },
        "paused": {
          "type": "boolean"
        },
        "playback_rate": {
          "type": "number",
          "format": "double"
        },
        "seeking": {
          "type": "boolean"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "media_generation",
        "seq",
        "event",
        "media_time_ms",
        "paused",
        "seeking",
        "buffering",
        "playback_rate",
        "has_played"
      ]
    },
    "PlaybackObservationEvent": {
      "type": "string",
      "enum": [
        "playing",
        "pause",
        "progress",
        "seeking",
        "seeked",
        "buffering",
        "ended"
      ]
    },
    "VideoCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        },
        "framerate": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "width",
        "height",
        "bitrate",
        "framerate"
      ]
    }
  }
}