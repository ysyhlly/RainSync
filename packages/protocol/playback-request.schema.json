{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackRequest",
  "description": "Missing optional fields preserve the original v1 playback request defaults.",
  "type": "object",
  "properties": {
    "advanced_playback": {
      "description": "Dedicated advanced-local route only. Absence preserves legacy hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/AdvancedPlaybackRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "candidate_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackCandidateReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackCapabilities"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "distributed_compute": {
      "description": "Dedicated primary NAS output endpoint; absence preserves legacy hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/DistributedComputePlaybackIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "finite_hls_version": {
      "description": "Explicit finite-HLS local transcode admission only.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "http_file_fallback": {
      "anyOf": [
        {
          "$ref": "#/$defs/HttpFileFallback"
        },
        {
          "type": "null"
        }
      ]
    },
    "http_file_fallback_version": {
      "description": "Negotiate single-hop verified HTTP-file continuation; absence is legacy.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "default": null
    },
    "local_hls_ladder": {
      "description": "Dedicated local multirendition endpoint only; absence preserves legacy hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/LocalHlsLadderRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "media_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "native_platform": {
      "description": "Dedicated native-platform route only. Absence preserves legacy hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/NativePlatformPlaybackIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "plan_generation": {
      "description": "Positive monotonic intent generation within user/room/viewer scope.\nMust be supplied together with viewer_id; same-key retries retain it.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1
    },
    "playback_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackMetricsIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "playback_metrics_supported_versions": {
      "description": "Outer offer is ignored by old servers. Absence preserves canonical hashes.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "maxItems": 2,
      "minItems": 1
    },
    "playback_metrics_version": {
      "description": "Optional independent client-reported metrics; observations v1 is unchanged.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "position_ms": {
      "type": "number",
      "format": "double",
      "default": 0.0
    },
    "room_id": {
      "type": "string",
      "format": "uuid"
    },
    "static_hls_fallback_version": {
      "description": "Opt into verified static-HLS parent preparation. Absence is legacy.\nA child continuation is advertised separately only when implemented.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "upstream_profile_report": {
      "description": "Dedicated upstream-profile route only; absence preserves legacy hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/UpstreamProfileReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "viewer_id": {
      "description": "Opaque per-player identity for ordering only, never authorization.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "room_id",
    "media_generation"
  ],
  "$defs": {
    "AdvancedPlaybackRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 1,
          "minimum": 1
        },
        "subtitle_stream_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tone_map_hdr": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tone_map_hdr"
      ]
    },
    "AudioCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channels": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "samplerate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "channels",
        "bitrate",
        "samplerate"
      ]
    },
    "CapabilityReport": {
      "description": "A small set of concrete sample hints, not a device-wide codec/size guarantee.",
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaCapabilityCandidate"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "candidates"
      ]
    },
    "DistributedComputePlaybackIntent": {
      "description": "Dedicated primary endpoint only. An output ID is a choice, never authority.",
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "output_generation": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "output_generation"
      ]
    },
    "HttpFileFallback": {
      "description": "A parent ID is only an authenticated lookup key, never a bearer grant.\nThe final observation is captured once before detaching the parent's media.",
      "type": "object",
      "properties": {
        "final_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "parent_session_id"
      ]
    },
    "LocalHlsLadderRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version"
      ]
    },
    "MediaCapabilityCandidate": {
      "type": "object",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioCapabilityConfiguration"
        },
        "content_type": {
          "description": "Combined container/codec MIME type tested through canPlayType and MSE.",
          "type": "string"
        },
        "file_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "description": "Omitted means unavailable or failed, not supported.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "progressive": {
          "$ref": "#/$defs/MediaTypeSupport"
        },
        "video": {
          "$ref": "#/$defs/VideoCapabilityConfiguration"
        }
      },
      "required": [
        "content_type",
        "video",
        "audio",
        "progressive"
      ]
    },
    "MediaDecodingSupport": {
      "description": "Estimates apply only to the accompanying configuration and decoding path.",
      "type": "object",
      "properties": {
        "power_efficient": {
          "type": "boolean"
        },
        "smooth": {
          "type": "boolean"
        },
        "supported": {
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "smooth",
        "power_efficient"
      ]
    },
    "MediaTypeSupport": {
      "description": "Browser MIME-type hints are not guarantees for arbitrary media or hardware.",
      "type": "string",
      "enum": [
        "unknown",
        "unsupported",
        "maybe",
        "probably"
      ]
    },
    "NativePlatformCompatibilityIntent": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/NativePlatformCompatibilityMode"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "mode"
      ]
    },
    "NativePlatformCompatibilityMode": {
      "description": "A closed, explicit request for the server-owned clear-media recipe.\nIt never carries extractor flags, upstream URLs or credential material.",
      "type": "string",
      "enum": [
        "hls_avc_aac",
        "hls_avc_aac_ladder"
      ]
    },
    "NativePlatformCredentialMode": {
      "type": "string",
      "enum": [
        "own_or_anonymous",
        "anonymous"
      ]
    },
    "NativePlatformMaxHeight": {
      "description": "Closed height ceilings. These are application policy, never extractor flags\nor a promise that a provider has a rendition at the named height.",
      "type": "string",
      "enum": [
        "auto",
        "p144",
        "p240",
        "p360",
        "p480",
        "p720",
        "p1080",
        "p1440",
        "p2160",
        "p4320"
      ]
    },
    "NativePlatformPlaybackIntent": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "compatibility": {
          "description": "Dedicated compatibility prepare route only; absence preserves v1 hashes.",
          "anyOf": [
            {
              "$ref": "#/$defs/NativePlatformCompatibilityIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_version": {
          "description": "Explicit opt-in to the distinct, positively entitled course route.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        },
        "credential_mode": {
          "$ref": "#/$defs/NativePlatformCredentialMode"
        },
        "live_version": {
          "description": "Explicit opt-in to live-edge/control semantics; absence is legacy VOD.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 2,
          "minimum": 1
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePlatformQualityIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "credential_mode"
      ]
    },
    "NativePlatformProvider": {
      "type": "string",
      "enum": [
        "bilibili",
        "douyin",
        "tiktok",
        "youtube"
      ]
    },
    "NativePlatformQualityIntent": {
      "type": "object",
      "properties": {
        "max_height": {
          "$ref": "#/$defs/NativePlatformMaxHeight"
        },
        "media_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "$ref": "#/$defs/NativePlatformProvider"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "provider",
        "media_id",
        "max_height"
      ]
    },
    "PlaybackCandidateReport": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "excluded_candidates": {
          "description": "Bounded client decode-failure history; never changes authorization.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaybackCandidateResult"
          }
        }
      },
      "required": [
        "binding",
        "results"
      ]
    },
    "PlaybackCandidateResult": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "file_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "progressive": {
          "$ref": "#/$defs/MediaTypeSupport"
        }
      },
      "required": [
        "candidate_id",
        "progressive"
      ]
    },
    "PlaybackCapabilities": {
      "description": "Independently detected transports; MSE support does not imply progressive support.",
      "type": "object",
      "properties": {
        "mse_h264_aac": {
          "type": "boolean"
        },
        "native_hls": {
          "type": "boolean"
        },
        "progressive_h264_aac": {
          "type": "boolean"
        },
        "report": {
          "description": "Optional additive hints. Old clients retain the original transport gates.",
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "progressive_h264_aac",
        "native_hls",
        "mse_h264_aac"
      ]
    },
    "PlaybackMetricsIntent": {
      "type": "object",
      "properties": {
        "meter_start_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "startup_origin": {
          "$ref": "#/$defs/PlaybackMetricsOrigin"
        }
      },
      "additionalProperties": false,
      "required": [
        "meter_start_generation",
        "startup_origin"
      ]
    },
    "PlaybackMetricsOrigin": {
      "type": "string",
      "enum": [
        "user_intent",
        "automatic_load"
      ]
    },
    "PlaybackObservation": {
      "description": "An immutable sample of the actual media element, relative to its plan.\n`has_played` is cumulative for that grant, even when the latest sample pauses.",
      "type": "object",
      "properties": {
        "buffering": {
          "type": "boolean"
        },
        "event": {
          "$ref": "#/$defs/PlaybackObservationEvent"
        },
        "has_played": {
          "type": "boolean"
        },
        "media_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "media_time_ms": {
          "type": "number",
          "format": "double"
        },
        "paused": {
          "type": "boolean"
        },
        "playback_rate": {
          "type": "number",
          "format": "double"
        },
        "seeking": {
          "type": "boolean"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "media_generation",
        "seq",
        "event",
        "media_time_ms",
        "paused",
        "seeking",
        "buffering",
        "playback_rate",
        "has_played"
      ]
    },
    "PlaybackObservationEvent": {
      "type": "string",
      "enum": [
        "playing",
        "pause",
        "progress",
        "seeking",
        "seeked",
        "buffering",
        "ended"
      ]
    },
    "UpstreamAudioRateReport": {
      "type": "object",
      "properties": {
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "type": "boolean"
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sample_rate",
        "mse_supported"
      ]
    },
    "UpstreamProfileReport": {
      "description": "Only the dedicated preparation endpoint accepts this report. It grants no\nauthority and cannot describe a replacement recipe or automatic fallback.",
      "type": "object",
      "properties": {
        "audio_rate_reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpstreamAudioRateReport"
          }
        },
        "binding": {
          "type": "string"
        },
        "mse_decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaDecodingSupport"
            },
            {
              "type": "null"
            }
          ]
        },
        "mse_supported": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_version",
        "binding",
        "profile_id",
        "mse_supported"
      ]
    },
    "VideoCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        },
        "framerate": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "width",
        "height",
        "bitrate",
        "framerate"
      ]
    }
  }
}