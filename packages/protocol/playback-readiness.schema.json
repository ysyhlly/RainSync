{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackReadiness",
  "description": "Ready means the entry can be loaded, not that the entire movie is encoded.",
  "type": "object",
  "properties": {
    "available_until_ms": {
      "description": "Exclusive end of the published prefix, relative to the plan's timeline origin.\nNone means this source/legacy output has no measured generated interval.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "complete": {
      "type": "boolean"
    },
    "observation_seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "observation_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "pending_job_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "plan_generation": {
      "description": "Echoes the immutable grant generation, independent of job attempts.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1
    },
    "seekable_media_ranges_ms": {
      "description": "Original-media intervals; absent is unknown, while [] is known empty.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PlaybackMediaRange"
      }
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "$ref": "#/$defs/PreparationStatus"
    }
  },
  "required": [
    "session_id",
    "status",
    "complete"
  ],
  "$defs": {
    "PlaybackMediaRange": {
      "description": "A measured or otherwise established interval in original-media time.\nThe start is inclusive and the end is exclusive; an empty interval is omitted.",
      "type": "object",
      "properties": {
        "end_ms": {
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "start_ms": {
          "type": "number",
          "format": "double",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ]
    },
    "PreparationStatus": {
      "type": "string",
      "enum": [
        "queued",
        "preparing",
        "ready"
      ]
    }
  }
}