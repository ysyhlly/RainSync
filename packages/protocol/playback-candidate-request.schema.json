{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackCandidateRequest",
  "type": "object",
  "properties": {
    "audio_index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "http_file_capabilities_version": {
      "description": "Opt in to version-bound, reliable single-file HTTP candidates.\nOmitted by explicit-direct requests, which must not force source probing.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "media_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "position_ms": {
      "type": "number",
      "format": "double",
      "default": 0.0
    },
    "room_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "room_id",
    "media_generation"
  ]
}