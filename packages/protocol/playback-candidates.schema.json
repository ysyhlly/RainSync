{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackCandidateSet",
  "type": "object",
  "properties": {
    "binding": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlaybackCandidate"
      }
    },
    "decision_reason": {
      "type": "string"
    },
    "http_file_capabilities_version": {
      "description": "Present only for a verified HTTP Binary binding. The client retains the\noriginal binding across automatic route changes within the same intent.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "route_decisions": {
      "description": "At most the four server routes. Absent on legacy/unsupported providers.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PlaybackRouteDecision"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "candidates",
    "decision_reason"
  ],
  "$defs": {
    "AudioCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channels": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "samplerate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "channels",
        "bitrate",
        "samplerate"
      ]
    },
    "PlaybackCandidate": {
      "description": "A server-issued exact input/output configuration, not an arbitrary device profile.",
      "type": "object",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioCapabilityConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_type": {
          "type": "string"
        },
        "delivery_mode": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "video": {
          "$ref": "#/$defs/VideoCapabilityConfiguration"
        }
      },
      "required": [
        "id",
        "delivery_mode",
        "transport",
        "content_type",
        "video"
      ]
    },
    "PlaybackRouteDecision": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "offered": {
          "description": "Offered for concrete client testing, not proven device decoding.",
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/PlaybackRouteReason"
        }
      },
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "offered",
        "reason"
      ]
    },
    "PlaybackRouteReason": {
      "description": "Why the server offered or omitted a route, before any device test.",
      "type": "string",
      "enum": [
        "source_configuration",
        "constrained_encoder_recipe",
        "video_configuration_unavailable",
        "video_copy_unsupported",
        "sample_entry_unsupported",
        "video_transform_required",
        "container_unsupported",
        "track_mapping_required",
        "audio_configuration_unavailable",
        "no_audio_track",
        "nonzero_copy_origin"
      ]
    },
    "VideoCapabilityConfiguration": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        },
        "framerate": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "content_type",
        "width",
        "height",
        "bitrate",
        "framerate"
      ]
    }
  }
}