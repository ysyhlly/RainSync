{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackObservationReceipt",
  "type": "object",
  "properties": {
    "has_played": {
      "type": "boolean"
    },
    "observation_seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "session_id",
    "observation_seq",
    "has_played"
  ]
}