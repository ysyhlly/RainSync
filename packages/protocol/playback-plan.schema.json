{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybackPlan",
  "type": "object",
  "properties": {
    "audio_tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaTrack"
      }
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "decoder_fallback_modes": {
      "description": "Evidence-backed next request modes, never access or decode guarantees.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DecoderFallbackMode"
      }
    },
    "delivery_mode": {
      "type": "string"
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "expires_in_seconds": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "http_file_fallback_version": {
      "description": "This live root grant supports one same-representation HTTP file→transcode\ntransition. Absent for legacy, unsupported inputs and successor grants.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "media_generation": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "media_id": {
      "type": "string",
      "format": "uuid"
    },
    "observation_seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "observation_version": {
      "description": "Present only when this grant negotiated actual viewer observations.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "pending_job_id": {
      "description": "A real authorized local job only while queued or running.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "plan_generation": {
      "description": "Per-viewer intent generation; absent for legacy grants. Never room revision.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1
    },
    "playback_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaybackMetricsGrant"
        },
        {
          "type": "null"
        }
      ]
    },
    "playback_metrics_version": {
      "description": "Optional independent client-reported metrics; observations v1 is unchanged.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "playback_url": {
      "type": "string"
    },
    "rebuild_on_seek": {
      "type": "boolean"
    },
    "seekable_media_ranges_ms": {
      "description": "Original-media intervals; absent is unknown, while [] is known empty.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PlaybackMediaRange"
      }
    },
    "selected_audio_track": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "selected_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "subtitle_mode": {
      "description": "Available delivery pipeline, not the user's currently selected subtitle.",
      "anyOf": [
        {
          "$ref": "#/$defs/SubtitleDeliveryMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "subtitle_tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaTrack"
      }
    },
    "timeline_origin_ms": {
      "type": "number",
      "format": "double"
    },
    "transport": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "media_id",
    "media_generation",
    "delivery_mode",
    "transport",
    "playback_url",
    "timeline_origin_ms",
    "expires_in_seconds",
    "rebuild_on_seek",
    "audio_tracks",
    "subtitle_tracks"
  ],
  "$defs": {
    "DecoderFallbackMode": {
      "description": "A next request mode justified by existing source/output evidence. It is\nneither authorization nor a guarantee that the device will decode it.",
      "type": "string",
      "enum": [
        "remux",
        "transcode"
      ]
    },
    "MediaTrack": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "label",
        "language"
      ]
    },
    "PlaybackMediaRange": {
      "description": "A measured or otherwise established interval in original-media time.\nThe start is inclusive and the end is exclusive; an empty interval is omitted.",
      "type": "object",
      "properties": {
        "end_ms": {
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "start_ms": {
          "type": "number",
          "format": "double",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ]
    },
    "PlaybackMetricsFirstFrame": {
      "type": "object",
      "properties": {
        "confirmed_elapsed_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "evidence": {
          "$ref": "#/$defs/PlaybackMetricsFrameEvidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "elapsed_ms",
        "confirmed_elapsed_ms",
        "evidence"
      ]
    },
    "PlaybackMetricsFrameEvidence": {
      "type": "string",
      "enum": [
        "video_frame_callback",
        "playing_time_advance"
      ]
    },
    "PlaybackMetricsGrant": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "last_sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackMetricsSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "meter_start_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "metrics_seq": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "startup_origin": {
          "$ref": "#/$defs/PlaybackMetricsOrigin"
        }
      },
      "additionalProperties": false,
      "required": [
        "meter_start_generation",
        "startup_origin",
        "metrics_seq",
        "closed"
      ]
    },
    "PlaybackMetricsOrigin": {
      "type": "string",
      "enum": [
        "user_intent",
        "automatic_load"
      ]
    },
    "PlaybackMetricsSample": {
      "type": "object",
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "final": {
          "type": "boolean"
        },
        "first_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackMetricsFirstFrame"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "meter_start_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "plan_generation": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "startup_origin": {
          "$ref": "#/$defs/PlaybackMetricsOrigin"
        },
        "totals": {
          "$ref": "#/$defs/PlaybackMetricsTotals"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "media_generation",
        "plan_generation",
        "meter_start_generation",
        "seq",
        "startup_origin",
        "elapsed_ms",
        "totals",
        "final"
      ]
    },
    "PlaybackMetricsTotals": {
      "type": "object",
      "properties": {
        "autoplay_blocked_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "background_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "paused_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "playing_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "rebuffer_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "seeking_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "startup_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        },
        "unobserved_ms": {
          "type": "integer",
          "format": "uint32",
          "maximum": 604800000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "startup_ms",
        "autoplay_blocked_ms",
        "background_ms",
        "paused_ms",
        "seeking_ms",
        "rebuffer_ms",
        "playing_ms",
        "unobserved_ms"
      ]
    },
    "SubtitleDeliveryMode": {
      "description": "Subtitle delivery available in the plan, independent of local selection.",
      "type": "string",
      "enum": [
        "none",
        "external_vtt"
      ]
    }
  }
}