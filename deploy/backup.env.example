# Private runtime copy: /etc/rainsync/backup.env, owner rainsync-backup, mode 0600.
# This file contains placeholders and is never loaded automatically.
DATABASE_URL=postgres://rainsync:REPLACE_PRIVATELY@127.0.0.1:54329/rainsync
RAINSYNC_BACKUP_SOURCE_COMMIT=REPLACE_WITH_INSTALLED_40_CHARACTER_GIT_SHA
RAINSYNC_BACKUP_DATABASE_ROOT=/srv/rainsync-backup/database
RAINSYNC_BACKUP_MATERIAL_ROOT=/srv/rainsync-backup/materials
RAINSYNC_BACKUP_STATE_ROOT=/var/lib/rainsync-backup
RAINSYNC_BACKUP_RETENTION_DAYS=14
RAINSYNC_BACKUP_KEY_FILE=/etc/rainsync/backup-secrets/database.key
RAINSYNC_MATERIAL_KEY_FILE=/etc/rainsync/backup-secrets/material.key
RAINSYNC_RECOVERY_INPUT_FILE=/etc/rainsync/backup-secrets/materials.json
# Optional absolute directory containing PostgreSQL 17 client binaries.
# RAINSYNC_NATIVE_POSTGRES_BIN=/usr/lib/postgresql/17/bin
