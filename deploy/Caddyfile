{$SITE_ADDRESS:localhost} {
    handle /api/* {
        reverse_proxy server:8080
    }
    handle /media-delivery/* {
        reverse_proxy worker:8081
    }
    handle /agent-data/* {
        reverse_proxy worker:8081
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
